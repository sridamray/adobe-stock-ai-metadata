{
  "manifest_version": 3,
  "name": "Adobe Stock AI Metadata Assistant",
  "version": "1.5.0",
  "description": "Generate Adobe Stock titles and keywords using OpenAI or Google Gemini, then fill Adobe Stock metadata fields.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://contributor.stock.adobe.com/*",
    "https://*.stock.adobe.com/*",
    "https://api.openai.com/*",
    "https://*.ftcdn.net/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "action": {
    "default_title": "Adobe Stock AI Metadata",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://contributor.stock.adobe.com/*",
        "https://*.stock.adobe.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}